<Window x:Class="AimLab.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AimLab.UI"
        Title="AimLab — Offline CS2-style Aim Trainer (simulation)"
        Width="1400" Height="880" MinWidth="1040" MinHeight="660"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SESSION" Style="{StaticResource Header}" Margin="0,0,0,6" />
                    <Button Content="▶ Start timed session" Command="{Binding StartSessionCommand}" FontWeight="SemiBold" Background="{StaticResource Accent}" HorizontalAlignment="Stretch" />
                    <WrapPanel>
                        <Button Content="Stop" Command="{Binding StopSessionCommand}" />
                        <Button Content="Free play" Command="{Binding FreePlayCommand}" />
                    </WrapPanel>
                    <TextBlock Text="Scenario values apply when a session starts." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />

                    <TextBlock Text="MODE" Style="{StaticResource Header}" />
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Training.Mode}" />
                    <TextBlock Text="VISIBILITY" Style="{StaticResource Header}" />
                    <ComboBox ItemsSource="{Binding Visibilities}" SelectedItem="{Binding Training.Visibility}" />
                    <TextBlock Text="SEED" Style="{StaticResource Header}" />
                    <TextBox Text="{Binding Training.Seed, UpdateSourceTrigger=LostFocus}" Background="{StaticResource PanelAlt}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" Padding="6,4" CaretBrush="{StaticResource Text}" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.DurationSeconds, StringFormat={}{0:F0}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="DURATION (S)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="10" Maximum="600" Value="{Binding Training.DurationSeconds}" SmallChange="5" LargeChange="30" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.TargetSpeed, StringFormat={}{0:F0}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="TARGET SPEED (U/S)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="600" Value="{Binding Training.TargetSpeed}" SmallChange="10" LargeChange="50" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.HeadRadius, StringFormat={}{0:F1}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="HEAD RADIUS (U)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="2" Maximum="40" Value="{Binding Training.HeadRadius}" SmallChange="0.5" LargeChange="2" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.BodyRadius, StringFormat={}{0:F1}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="BODY RADIUS (U)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="4" Maximum="60" Value="{Binding Training.BodyRadius}" SmallChange="0.5" LargeChange="2" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.MinDistance, StringFormat={}{0:F0}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="MIN DISTANCE (U)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="100" Maximum="3000" Value="{Binding Training.MinDistance}" SmallChange="25" LargeChange="100" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.MaxDistance, StringFormat={}{0:F0}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="MAX DISTANCE (U)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="100" Maximum="3000" Value="{Binding Training.MaxDistance}" SmallChange="25" LargeChange="100" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.SpawnYawSpread, StringFormat={}{0:F0}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="SPAWN YAW SPREAD ±°" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="5" Maximum="90" Value="{Binding Training.SpawnYawSpread}" SmallChange="1" LargeChange="5" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.SpawnPitchSpread, StringFormat={}{0:F0}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="SPAWN PITCH SPREAD ±°" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="30" Value="{Binding Training.SpawnPitchSpread}" SmallChange="1" LargeChange="5" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.TargetCount, StringFormat={}{0}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="SWITCH TARGETS" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="8" Value="{Binding Training.TargetCount}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.PeekVisibleSeconds, StringFormat={}{0:F1}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="PEEK VISIBLE (S)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="0.1" Maximum="5" Value="{Binding Training.PeekVisibleSeconds}" SmallChange="0.1" LargeChange="0.5" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.PeekHiddenSeconds, StringFormat={}{0:F1}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="PEEK HIDDEN (S)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="0.1" Maximum="5" Value="{Binding Training.PeekHiddenSeconds}" SmallChange="0.1" LargeChange="0.5" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.FireIntervalSeconds, StringFormat={}{0:F2}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="FIRE INTERVAL (S)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="0.02" Maximum="2" Value="{Binding Training.FireIntervalSeconds}" SmallChange="0.01" LargeChange="0.1" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.RespawnDelaySeconds, StringFormat={}{0:F2}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="RESPAWN DELAY (S)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="5" Value="{Binding Training.RespawnDelaySeconds}" SmallChange="0.05" LargeChange="0.5" />

                    <TextBlock Text="MOUSE (IN-APP ONLY)" Style="{StaticResource Header}" Margin="0,18,0,6" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.MouseSensitivity, StringFormat={}{0:F2}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="SENSITIVITY" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="0.01" Maximum="20" Value="{Binding Training.MouseSensitivity}" SmallChange="0.05" LargeChange="0.5" />
                    <TextBlock Text="YAW / PITCH DEGREES PER COUNT" Style="{StaticResource Header}" />
                    <UniformGrid Columns="2">
                        <TextBox Text="{Binding Training.YawDegreesPerCount, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" Background="{StaticResource PanelAlt}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" Padding="6,4" />
                        <TextBox Text="{Binding Training.PitchDegreesPerCount, UpdateSourceTrigger=LostFocus}" Margin="4,0,0,0" Background="{StaticResource PanelAlt}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" Padding="6,4" />
                    </UniformGrid>
                    <CheckBox Content="Invert Y" IsChecked="{Binding Training.InvertY}" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Training.CameraFov, StringFormat={}{0:F0}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="CAMERA FOV (HORIZONTAL °)" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="60" Maximum="130" Value="{Binding Training.CameraFov}" SmallChange="1" LargeChange="5" />

                    <TextBlock Text="AIM ASSIST (RESEARCH)" Style="{StaticResource Header}" Margin="0,18,0,6" />
                    <CheckBox Content="Assist enabled" IsChecked="{Binding Settings.Enabled}" />
                    <CheckBox Content="Visibility check" IsChecked="{Binding Settings.VisibilityCheck}" />
                    <CheckBox Content="Require activation key" IsChecked="{Binding Settings.RequireActivationKey}" />
                    <TextBlock Text="ACTIVATION KEY" Style="{StaticResource Header}" />
                    <ComboBox ItemsSource="{Binding ActivationKeys}" SelectedItem="{Binding Settings.ActivationKey}" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Settings.Fov, StringFormat={}{0:F0}°}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="ANALYSIS / ASSIST FOV" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="180" Value="{Binding Settings.Fov}" SmallChange="1" LargeChange="10" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Settings.Smoothing, StringFormat={}{0:F1}}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="SMOOTHING" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="50" Value="{Binding Settings.Smoothing}" SmallChange="0.5" LargeChange="5" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Settings.AcquireThresholdDegrees, StringFormat={}{0:F1}°}" DockPanel.Dock="Right" Style="{StaticResource Mono}" />
                        <TextBlock Text="ACQUIRE THRESHOLD" Style="{StaticResource Header}" Margin="0" />
                    </DockPanel>
                    <Slider Minimum="0.1" Maximum="10" Value="{Binding Settings.AcquireThresholdDegrees}" SmallChange="0.1" LargeChange="1" />
                    <TextBlock Text="TARGET PRIORITY" Style="{StaticResource Header}" />
                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Settings.Priority}" />
                    <TextBlock Text="BODY REGION" Style="{StaticResource Header}" />
                    <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding Settings.Region}" />

                    <TextBlock Text="VIEW" Style="{StaticResource Header}" Margin="0,18,0,6" />
                    <CheckBox Content="Radar (debug / analysis)" IsChecked="{Binding ShowRadar}" />
                    <CheckBox Content="FOV sector" IsChecked="{Binding ShowFovCone}" />
                    <CheckBox Content="Other candidates" IsChecked="{Binding ShowCandidates}" />
                    <CheckBox Content="Hidden enemies" IsChecked="{Binding ShowHidden}" />
                    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Margin="16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding SessionHud}" Style="{StaticResource Mono}" FontSize="14" Margin="2,0,0,8" />
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <local:FirstPersonView x:Name="FirstPerson" Cursor="Cross" />
                    <local:RadarView x:Name="Radar" Visibility="{Binding ShowRadar, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Margin="12" VerticalAlignment="Top" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" IsHitTestVisible="False"
                               Text="Click the view to capture the mouse · left click: shoot · Esc: release · arrow keys: turn · input is read only while this window is focused" />
                    <Border Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" Background="#E6181B23"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Padding="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                        <StackPanel>
                            <TextBlock Text="SESSION RESULT" Style="{StaticResource Header}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Mono}" TextWrapping="Wrap" LineHeight="20" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" />
                                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                                <Button Content="Run again" Command="{Binding StartSessionCommand}" />
                                <Button Content="Close" Command="{Binding CloseResultCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ENTITIES" Style="{StaticResource Header}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding EntitySummary}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                    <TextBlock Text="PERFORMANCE" Style="{StaticResource Header}" />
                    <TextBlock Text="{Binding Performance}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                    <TextBlock Text="CURRENT TARGET" Style="{StaticResource Header}" />
                    <TextBlock Text="{Binding TargetInfo}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                    <TextBlock Text="TELEMETRY" Style="{StaticResource Header}" />
                    <TextBlock Text="{Binding TelemetryInfo}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" />
                        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                        <Button Content="Reset" Command="{Binding ResetTelemetryCommand}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="2,10,0,0">
            <TextBlock Foreground="#FFC84A" FontSize="11" TextWrapping="Wrap"
                       Text="SIMULATION, not CS2: hit volumes are spheres, any hit eliminates (tracking: never), no recoil, spread, movement inaccuracy or tick interpolation. Distances are simulation units. Sensitivity uses configurable degrees-per-count values." />
            <TextBlock Foreground="{StaticResource Muted}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Window>
